{
  "name": "exam-helper-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "eval:practice": "node --import tsx eval/run.ts",
    "test:practice:mongo": "node --import tsx --test integration/mongo.test.ts",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@google/adk": "^2.3.0",
    "@types/multer": "^2.3.0",
    "better-auth": "^1.7.6",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "mongodb": "^6.21.0",
    "multer": "^2.4.0",
    "pdfkit": "^0.18.0",
    "pino": "^9.14.0",
    "resend": "^4.8.0",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
